# Safe example configuration. 
ADMIN_PASSWORD=replace-with-output-of-openssl-rand-base64-32
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=8
SOUNDFONT_PATH=/opt/aips/soundfonts/MuseScore_General.sf3
SOUNDFONT_PACK_ID=general-midi
AIPS_BACKEND_BASE_URL=https://radio-backend.example.com
AIPS_MEDIA_BASE_URL=https://radio-media.example.com
AIPS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:8765,http://127.0.0.1:8765
AIPS_TRUSTED_PROXY_RANGES=127.0.0.1/32,::1/128
AIPS_SECURE_COOKIES=1
AIPS_COOKIE_SAMESITE=None
RADIO_STATE_SALT=replace-with-another-random-string
AIPS_STATE_DIR=/var/lib/aips/radio-state
AIPS_ARCHIVE_DIR=/var/lib/aips/media/archive
AIPS_RECORDINGS_DIR=/var/lib/aips/media/recordings
AIPS_SESSIONS_DIR=/var/lib/aips/media/sessions
